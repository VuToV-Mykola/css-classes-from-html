    checks.push(`Frontend files: ${fs.existsSync(frontendPath) ? "✅" : "❌"}`)
    
    const report = checks.join("\n")
    outputChannel?.appendLine("📊 System Validation Report:")
    outputChannel?.appendLine(report)
    
