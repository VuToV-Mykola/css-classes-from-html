{
  "name": "css-classes-from-html",
  "displayName": "CSS Classes from HTML v0.0.7",
  "description": "Автоматична генерація CSS класів з HTML файлів з реальною інтеграцією Figma",
  "version": "0.0.7",
  "publisher": "vutov-mykola",
  "author": {
    "name": "VuToV-Mykola",
    "email": "vutov_nikola@icloud.com"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0",
    "node": ">=16.0.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Formatters",
    "Extension Packs"
  ],
  "keywords": [
    "css",
    "html",
    "figma",
    "generator",
    "classes",
    "frontend",
    "ui",
    "design",
    "automation",
    "integration"
  ],
  "main": "./extension.js",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#007ACC",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:css",
    "onCommand:css-classes.showMenu",
    "onCommand:css-classes.showMenuFromContext",
    "onCommand:css-classes.quickGenerate",
    "onCommand:css-classes.generateMaximalCSS",
    "onCommand:css-classes.selectHTMLFile"
  ],
  "contributes": {
    "commands": [
      {
        "command": "css-classes.showMenu",
        "title": "🎨 Show Main Menu",
        "category": " CSS Classes from HTML",
        "icon": "$(symbol-class)"
      },
      {
        "command": "css-classes.showMenuFromContext",
        "title": "🇺🇦 Generate CSS from THIS HTML",
        "category": " CSS Classes from HTML",
        "icon": "$(output)"
      },
      {
        "command": "css-classes.quickGenerate",
        "title": "⚡ Quick Generate CSS",
        "category": " CSS Classes from HTML",
        "icon": "$(zap)"
      },
      {
        "command": "css-classes.generateMaximalCSS",
        "title": "❤️‍🔥 Generate Maximal CSS",
        "category": " CSS Classes from HTML",
        "icon": "$(link-external)"
      },
      {
        "command": "css-classes.selectHTMLFile",
        "title": "📂 Select HTML File for Generation",
        "category": " CSS Classes from HTML",
        "icon": "$(file-code)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "css-classes.showMenuFromContext",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": " CSS Generation@1"
        },
        {
          "command": "css-classes.quickGenerate",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": " CSS Generation@2"
        },
        {
          "command": "css-classes.generateMaximalCSS",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": " CSS Generation@3"
        }
      ],
      "editor/context": [
        {
          "command": "css-classes.showMenuFromContext",
          "when": "resourceLangId == html",
          "group": " CSS Generation@1"
        },
        {
          "command": "css-classes.quickGenerate",
          "when": "resourceLangId == html",
          "group": " CSS Generation@2"
        },
        {
          "command": "css-classes.generateMaximalCSS",
          "when": "resourceLangId == html",
          "group": " CSS Generation@3"
        }
      ],
      "editor/title": [
        {
          "command": "css-classes.quickGenerate",
          "when": "resourceLangId == html",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "css-classes.showMenu",
          "when": "true"
        },
        {
          "command": "css-classes.showMenuFromContext",
          "when": "resourceLangId == html"
        },
        {
          "command": "css-classes.quickGenerate",
          "when": "resourceLangId == html"
        },
        {
          "command": "css-classes.selectHTMLFile",
          "when": "true"
        }
      ]
    },
    "keybindings": [
      {
        "command": "css-classes.showMenu",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "css-classes.quickGenerate",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "resourceLangId == html"
      },
      {
        "command": "css-classes.selectHTMLFile",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h"
      }
    ],
    "configuration": {
      "title": "CSS Classes from HTML",
      "properties": {
        "cssClassesFromHtml.figmaToken": {
          "type": "string",
          "default": "",
          "description": "Figma API Token for integration",
          "scope": "application"
        },
        "cssClassesFromHtml.autoOpenCSS": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open generated CSS file"
        },
        "cssClassesFromHtml.includeReset": {
          "type": "boolean",
          "default": true,
          "description": "Include CSS reset styles"
        },
        "cssClassesFromHtml.includeVariables": {
          "type": "boolean",
          "default": true,
          "description": "Include CSS custom properties (variables)"
        },
        "cssClassesFromHtml.generateResponsive": {
          "type": "boolean",
          "default": true,
          "description": "Generate responsive media queries"
        },
        "cssClassesFromHtml.defaultHTMLFile": {
          "type": "string",
          "default": "",
          "description": "Default HTML file path for CSS generation"
        }
      }
    }
  },
  "scripts": {
    "build": "echo \"✅ Build completed for v0.0.7\" && npm run validate",
    "package": "vsce package --out ./builds/",
    "lint": "eslint . --ext .js,.ts --fix",
    "test": "bash scripts/tests.sh",
    "deploy": "bash scripts/deploy.sh",
    "validate": "node -e \"console.log('✅ Validation stub (VS Code API not loadable in Node)')\"",
    "clean": "rm -rf builds/* logs/deploy/*.log node_modules/.cache",
    "prepackage": "npm run validate",
    "postpackage": "echo \"📦 Package created successfully\"",
    "docs": "bash scripts/auto-generate-docs.sh",
    "manager": "bash scripts/project-manager.sh",
    "fix": "bash scripts/ultimate-fix-and-setup.sh",
    "start": "npm run build && npm run package",
    "figma:fetch": "node -e \"(async()=>{const I=require('./backend/core/IntegrationEngine');const C=require('./backend/core/FigmaAPIClient');const fs=require('fs');const file=process.env.FIGMA_FILE_KEY;const token=process.env.FIGMA_TOKEN; if(!file||!token){console.error('FIGMA_FILE_KEY/FIGMA_TOKEN required');process.exit(1)} const ie=new I({figmaToken:token}); const fileJson=await ie.figmaClient.getFile(file); fs.mkdirSync('assets/db',{recursive:true}); fs.writeFileSync('assets/db/figma-file.json', JSON.stringify(fileJson,null,2)); console.log('Saved assets/db/figma-file.json')})().catch(e=>{console.error(e.message);process.exit(1)})\"",
    "css:generate": "node -e \"(async()=>{const fs=require('fs');const path=require('path');const I=require('./backend/core/IntegrationEngine');const file=process.env.FIGMA_FILE_KEY;const token=process.env.FIGMA_TOKEN;const input=process.env.CSS_INPUT||'./index.html';const out=process.env.CSS_OUT||'./dist/figma-mapped.css'; if(!file||!token){console.error('FIGMA_FILE_KEY/FIGMA_TOKEN required');process.exit(1)} const html=fs.readFileSync(input,'utf8'); const ie=new I({figmaToken:token}); const {css}=await ie.generateCSS(file, html, {mode:'maximum', generateResponsive:true}); fs.mkdirSync(path.dirname(out),{recursive:true}); fs.writeFileSync(out, css); console.log('CSS written to', out)})().catch(e=>{console.error(e.message);process.exit(1)})\""
  },
  "dependencies": {
    "@ungap/structured-clone": "^1.3.0",
    "axios": "^1.6.0",
    "https": "^1.0.0",
    "jsdom": "^23.2.0",
    "parse-semver": "^1.1.1",
    "sharp": "^0.34.3",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VuToV-Mykola/css-classes-from-html.git"
  },
  "bugs": {
    "url": "https://github.com/VuToV-Mykola/css-classes-from-html/issues"
  },
  "homepage": "https://github.com/VuToV-Mykola/css-classes-from-html#readme"
}
