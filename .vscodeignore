# ✅ ОПТИМІЗОВАНИЙ .vscodeignore для css-classes-from-html
# Файли які виключаються з VSCode розширення при пакуванні

# Системні директорії
.vscode/**
.git/**
.github/**

# node_modules: залишаємо ВСІ залежності у пакеті (жодних виключень)
# Це гарантує наявність усіх transitively required модулів у рантаймі

# Dev/Build файли
*.log
*.map
*.ts
*.tsbuildinfo
.DS_Store
Thumbs.db
*.vsix
*.zip
*.tar.gz

# Тестування та покриття
test/**
tests/**
coverage/**
**/*.test.js
**/*.spec.js
.nyc_output

# Тимчасові директорії
tmp/**
temp/**
.history/
.cache/
out/**
dist/**
build/**
builds/**

# Конфігурація середовища
.env*
.eslintrc.js
.prettierrc.json
.stylelintrc.json
tsconfig.json
jsconfig.json
webpack.config.js

# Логи та звіти
logs/**
debugs/**
backups/**

# Великі активи й артефакти
assets/**
!assets/icon.png
figma-data.json
matching-results.json

# CI/CD
.travis.yml
.appveyor.yml
.codeclimate.yml
.coveralls.yml

# Скрипти розробки
scripts/**